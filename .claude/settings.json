{
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Read(~/.claude/skills/**)",
      "Skill(ases-dev)",
      "Skill(ases-dev:*)",
      "Skill(ases-critique)",
      "Skill(ases-critique:*)",
      "Skill(ases-validate)",
      "Skill(ases-validate:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(python3:*)",
      "Bash(python3 -c ':*)",
      "Bash(python3 .claude/hooks/ases-hook.py:*)",
      "Bash(python3 .claude/hooks/validate_schema.py:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pip install:*)",
      "Bash(pip show:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(graphify:*)",
      "Bash(psql:*)",
      "Bash(pg_isready:*)"
    ],
    "deny": [
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./production.config.*)",
      "Write(./.ases/decisions.json)",
      "Write(./.ases/global_context.json)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "allowedTools": [
      "Read",
      "Write",
      "View",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(npm:*)",
      "Bash(node:*)"
    ]
  },
  "model": "claude-sonnet-4-6",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/ases-hook.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/ases-hook.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/ases-hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write(.ases/context.json)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[ASES] Context updated: $(date)\" >> .ases/.audit.log"
          }
        ]
      },
      {
        "matcher": "Write(sprints/*/execution/snapshots/*.json)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[ASES] Snapshot saved: $CLAUDE_TOOL_FILE $(date)\" >> .ases/.audit.log"
          }
        ]
      }
    ]
  },
  "maxTokens": 8096
}
