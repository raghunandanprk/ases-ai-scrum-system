{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ases/v3.0/hld",
  "title": "ASES High-Level Design",
  "description": "Produced by /ases-hld. Consumed by /ases-lld, /ases-schema, /ases-roadmap, /ases-analyze, /ases-integration-test.",
  "type": "object",
  "required": ["system_overview", "modules", "data_flow"],
  "properties": {
    "system_overview": { "type": "string" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "responsibility", "layer"],
        "properties": {
          "id": { "type": "string", "pattern": "^M-\\d{3}$" },
          "name": { "type": "string" },
          "responsibility": { "type": "string" },
          "interfaces": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "layer": { "type": "string", "enum": ["presentation", "application", "domain", "infrastructure"] }
        }
      }
    },
    "data_flow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^DF-\\d{3}$" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "data": { "type": "string" },
          "protocol": { "type": "string" }
        }
      }
    },
    "external_dependencies": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": { "type": "string", "pattern": "^R-\\d{3}$" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "medium", "low"] },
          "mitigation": { "type": "string" },
          "module_ref": { "type": "string" }
        }
      }
    }
  }
}
