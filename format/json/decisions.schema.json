{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ases/v3.0/decisions",
  "title": "ASES Architectural Decisions",
  "description": "Produced by /ases-hld, /ases-lld, /ases-sprint-close. Consumed by /ases-critique, /ases-final-audit, /ases-validate.",
  "type": "object",
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stage", "sprint_id", "decision", "rationale", "module_refs", "recall_keywords", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^DS-\\d{3}$" },
          "stage": { "type": "string", "enum": ["hld", "lld", "sprint"] },
          "sprint_id": { "type": "string", "description": "Sprint ID (e.g. S1) or 'project' for project-level decisions" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "tradeoffs": { "type": "string" },
          "alternatives_considered": { "type": "array", "items": { "type": "string" } },
          "module_refs": {
            "type": "array",
            "description": "Module IDs this decision applies to (e.g. ['M-001', 'M-003']). Used by critique to filter relevant decisions.",
            "items": { "type": "string" }
          },
          "recall_keywords": {
            "type": "array",
            "description": "Keywords for contextual recall (e.g. ['caching', 'performance', 'redis'])",
            "items": { "type": "string" }
          },
          "made_by": { "type": "string", "enum": ["architect", "planner", "po"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["active", "superseded", "deferred"] }
        }
      }
    }
  }
}
