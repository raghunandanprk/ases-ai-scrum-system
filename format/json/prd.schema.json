{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ases/v3.0/prd",
  "title": "ASES Product Requirements Document",
  "description": "Produced by /ases-prd. Consumed by /ases-hld, /ases-lld, /ases-test-spec, /ases-sprint-gate, /ases-uat.",
  "type": "object",
  "required": ["prd_version", "product_name", "objective", "features"],
  "properties": {
    "prd_version": { "type": "integer", "minimum": 1 },
    "product_name": { "type": "string" },
    "objective": { "type": "string" },
    "users": { "type": "array", "items": { "type": "string" } },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "priority", "acceptance_criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-\\d{3}$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string", "enum": ["critical", "high", "low"] },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "criterion", "testable"],
              "properties": {
                "id": { "type": "string", "pattern": "^AC-\\d{3}$" },
                "criterion": { "type": "string" },
                "testable": { "type": "boolean" }
              }
            }
          },
          "sprint_allocation": { "type": "string" }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "non_functional": {
      "type": "object",
      "properties": {
        "performance": { "type": "string" },
        "security": { "type": "string" },
        "scalability": { "type": "string" },
        "accessibility": { "type": "string" }
      }
    },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } }
  }
}
