{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ases/v3.0/ui_scaffold_manifest",
  "title": "ASES UI Scaffold Manifest",
  "description": "Produced by /ases-ui-scaffold. Consumed by /ases-dev, /ases-test-impl. Used by ases-hook.py UI guard.",
  "type": "object",
  "required": ["sprint_id", "framework", "scaffold_root", "components"],
  "properties": {
    "sprint_id": { "type": "string", "pattern": "^S\\d+$" },
    "framework": { "type": "string" },
    "scaffold_root": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "locked"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "task_ref": { "type": "string" },
          "locked": { "type": "boolean", "default": true },
          "integration_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "location"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["session_validation", "api_connection", "env_var", "auth_guard"] },
                "location": { "type": "string" },
                "instruction": { "type": "string" },
                "endpoint_ref": { "type": "string" },
                "mock_data_file": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "mock_data_files": { "type": "array", "items": { "type": "string" } },
    "env_vars_needed": { "type": "array", "items": { "type": "string" } }
  }
}
