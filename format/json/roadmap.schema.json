{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ases/v3.0/roadmap",
  "title": "ASES Sprint Roadmap",
  "description": "Produced by /ases-roadmap. Consumed by /ases-lld, /ases-sprint-gate, /ases-release.",
  "type": "object",
  "required": ["sprints"],
  "properties": {
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goal", "features", "modules"],
        "properties": {
          "id": { "type": "string", "pattern": "^S\\d+$" },
          "goal": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string", "pattern": "^F-\\d{3}$" } },
          "modules": { "type": "array", "items": { "type": "string", "pattern": "^M-\\d{3}$" } },
          "scope_notes": { "type": "string" },
          "dependencies_on": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["planned", "active", "complete", "deferred"] }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" },
          "target_sprint": { "type": "string" }
        }
      }
    }
  }
}
